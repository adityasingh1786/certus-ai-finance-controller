# =============================================================================
# Certus — AI Finance Controller
# Copy this file to .env and fill in your values
# =============================================================================

# Razorpay API (Test Mode — get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Database — SQLite default, set to postgresql:// for Supabase/production
DATABASE_URL=sqlite:///./ai_finance_controller.db

# LLM API Keys (all optional — leave empty to use deterministic fallback)
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# App Config
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-random-secret
CONFIDENCE_THRESHOLD=0.75
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
